{
  "name": "instant-wellness-backend",
  "version": "1.0.0",
  "description": "Drone delivery order management with NY State tax calculation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "geo-tz": "^8.1.5",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "local-reverse-geocoder": "^0.16.7",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^7.3.0",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tz-lookup": "^6.1.25",
    "zipcodes": "^8.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/decimal.js": "^0.0.32",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
